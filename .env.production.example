# ==============================================================
# BIDSTREAM - PRODUCTION ENVIRONMENT VARIABLES (AWS EC2)
# ==============================================================

# Node Environment
NODE_ENV=production
PORT=3000

# MongoDB Atlas Connection URI (Free M0 Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/auction_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Redis Password (Used internally by docker-compose)
REDIS_PASSWORD=generate_a_strong_redis_password_here

# JWT Configuration (MUST be at least 32 characters each)
JWT_SECRET=generate_at_least_32_characters_random_string_here_12345
JWT_REFRESH_SECRET=generate_at_least_32_characters_random_string_here_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Client URL (Your Amplify, CloudFront, or domain URL)
CLIENT_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Cloudinary (Image uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP (Optional for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
